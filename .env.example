# ─── NVIDIA Nemotron 3 Super ───────────────────────────────────────────────
# Get your free API key at: https://build.nvidia.com
# Model: nvidia/nemotron-3-super-120b-a12b (128K context, reasoning mode)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Jupiter (optional — free tier works without a key) ────────────────────
JUPITER_API_KEY=

# ─── Live Mainnet Trading (Phantom wallet) ─────────────────────────────────
#
# ⚠️  WARNING: Use a DEDICATED BURNER WALLET — NEVER your main Phantom wallet
#
# How to get your private key from Phantom:
#   1. Open Phantom → tap the account icon → "Add / Connect Wallet"
#   2. Create a BRAND NEW wallet (not your main one)
#   3. Send exactly $10 USDC + 0.02 SOL (for gas fees) to this new wallet
#   4. In Phantom: Settings → Security & Privacy → Export Private Key
#   5. Enter your password → copy the key shown
#   6. Paste it below as WALLET_PRIVATE_KEY
#
# Set LIVE_MODE=true to activate real on-chain trades
LIVE_MODE=false
WALLET_PRIVATE_KEY=

# Hard kill switch — bot halts automatically if total losses exceed this USD amount
MAX_LOSS_USD=10

# ─── Bot Tuning (optional — defaults work well out of the box) ─────────────
# ANALYSIS_INTERVAL_SEC=20
# DEMO_SOL_BALANCE=2.0
# DEMO_USDC_BALANCE=100.0
